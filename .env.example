# Option A: a local OpenAI-compatible model server (e.g. vLLM, Ollama, LM Studio).
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy-key
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=120

# Option B: Groq's free tier (https://console.groq.com) -- no local server
# needed. No credit card required; rate-limited, not unlimited.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT_SECONDS=120

# Optional: related videos from a curated list of trusted Islamic YouTube
# channels (data/trusted_channels.json). Without this, the app works fine
# and simply skips the videos section. Get a free key at
# https://console.cloud.google.com/apis/credentials after enabling
# "YouTube Data API v3" on that project -- no cost for normal usage (free
# quota is 10,000 units/day; each search costs 100 units per trusted
# channel). After setting this, run `python scripts/resolve_channels.py`
# once to resolve the channel handles.
# YOUTUBE_API_KEY=your_youtube_data_api_key_here
