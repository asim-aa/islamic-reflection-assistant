# Option A: a local OpenAI-compatible model server (e.g. vLLM, Ollama, LM Studio).
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy-key
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=120

# Option B: Groq's free tier (https://console.groq.com) -- no local server
# needed. No credit card required; rate-limited, not unlimited.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT_SECONDS=120

# Optional: related videos from a curated list of trusted Islamic YouTube
# channels (data/trusted_channels.json). Without this, the app works fine
# and simply skips the videos section. Get a free key at
# https://console.cloud.google.com/apis/credentials after enabling
# "YouTube Data API v3" on that project -- no cost for normal usage.
# Only used by scripts/refresh_video_index.py (run periodically, e.g. via
# cron -- see README) to build data/video_index.json; the running app
# searches that local file and makes no live YouTube call per user
# request. After setting this, run `python scripts/resolve_channels.py`
# once to resolve the channel handles, then
# `python scripts/refresh_video_index.py` to build the index.
# YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Only used by backend/main.py (the FastAPI backend for the Next.js
# frontend in frontend/ -- not needed if you're just running the
# Streamlit app.py). Comma-separated list of origins allowed to call the
# API; must include your deployed frontend's URL.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
